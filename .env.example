# Variables de entorno OPCIONALES. El prototipo funciona sin ninguna de ellas y NO necesita credenciales.
# main.py las lee del entorno del sistema (no carga archivos .env por sí mismo): exportalas en tu
# shell o usá `set -a; source .env; set +a` (Linux/macOS) antes de ejecutar.

# Máximo de ejecuciones de nodos por tarea (por defecto 12; mínimo permitido 4).
L10N_QA_MAX_STEPS=12

# Carpeta donde main.py guarda informe_qa.json e informe_qa.md (por defecto "salida").
L10N_QA_SALIDA=salida

# No hay claves de API en este proyecto: no se usan modelos de lenguaje ni servicios externos.
